@model VehicleServiceModel

<div class="col-md-4">
    <div class="card mb-3">
        <img class="card-img-top" src="@Model.ImageUrl" alt="Veicle Image" />
        <div class="card-body text-center">
            <h4>@Model.Model</h4>
            <h6>Mileage: @Model.Mileage</h6>
            <h6>Price: @Model.Price EUR</h6>
            <h6>(@(Model.IsSold ? "Sold" : "Available"))</h6>
            <br />
            <a asp-controller="Vehicle" asp-action="Details" asp-route-id="@Model.Id" class="btn-success">Details</a>
            @if (this.User.Identity.IsAuthenticated)
            {
                <a asp-controller="Vehicle" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                <a asp-controller="Vehicle" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
                <p></p>
                @if (!Model.IsSold)
                {
                    <p>Please contact with owner of the vehicle to arrange an appointment for inspection and/or test drive.</p>
                }
                else
                {
                    <p>This vehicle is already sold! Please choose another one.</p>
                }
            }
        </div>
    </div>
</div>
