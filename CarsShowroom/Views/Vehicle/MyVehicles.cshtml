@model IEnumerable<VehicleServiceModel>
@{
    ViewBag.Title = "My Vehicles";
}

<h2 class="text-center">@ViewBag.Title</h2>
<hr />
@if (!Model.Any())
{
    <h3 class="text-center">You have no vehicles yet!</h3>
}

<div class="row">
    @foreach(var vehicle in Model)
    {
        <partial name="_VehiclePartial" model="@vehicle" />
    }
</div>
